---
import "../styles/main.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const title = "Iosevka Paper — An Opinionated Monospace Font";
const description =
  "An opinionated condensed monospace font. Three weights, two widths, one way to look.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="KorigamiK" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://font.korigamik.dev/" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://font.korigamik.dev/" />
    <link rel="icon" href={`${base}/crane.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={`${base}/css/fonts.css`} />
    <script is:inline>
      // Set theme before paint to avoid flash
      (function () {
        try {
          var t = localStorage.getItem("theme");
          var dark =
            t === "dark" ||
            (t !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
          if (dark) document.documentElement.classList.add("dark");
          if (localStorage.getItem("iosevka-paper-width") === "ext")
            document.documentElement.classList.add("ext");
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <div class="bg-grid"><div class="bg-grid-lines"></div></div>
    <div class="bg-grid-mask"></div>

    <div class="page">
      <slot />
    </div>

    <div class="width-float mono" role="group" aria-label="Font width">
      <span>Width</span>
      <button class="chip active" data-width="normal">Default</button>
      <button class="chip" data-width="ext">Extended</button>
    </div>

    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"
      data-autoloader-path="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/"
    ></script>
    <script src="../scripts/main.js"></script>
  </body>
</html>
