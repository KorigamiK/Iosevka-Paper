<section id="tryit">
  <h2>Try It</h2>
  <p class="muted">The real font, served from the latest release. Type away.</p>
  <div class="try-editor">
    <div class="try-header">
      <div class="try-langs">
        <button class="chip active" data-try-lang="js">JS</button>
        <button class="chip" data-try-lang="py">Python</button>
        <button class="chip" data-try-lang="rust">Rust</button>
        <button class="chip" data-try-lang="cpp">C++</button>
        <button class="chip" data-try-lang="haskell">Haskell</button>
      </div>
      <div class="try-samples" id="try-samples"></div>
    </div>
    <div class="try-body">
      <pre class="try-gutter mono" id="try-gutter"></pre>
      <div class="try-input-wrap">
        <pre class="try-highlight mono"><code class="language-js" id="try-highlight"></code></pre>
        <pre class="try-input mono" id="try-input" contenteditable="true" spellcheck="false"></pre>
      </div>
    </div>
    <div class="try-status mono">
      <span>Iosevka Paper</span>
      <span id="try-status-lang">JavaScript</span>
    </div>
  </div>
</section>

<hr />

<section id="weights">
  <h2>Weights &amp; Styles</h2>
  <table class="wt-table">
    <thead><tr><th>Weight</th><th>CSS</th><th>Sample</th></tr></thead>
    <tbody>
      <tr><td>Regular</td><td class="mono">400</td><td class="mono wt-demo" style="font-weight:400">Sphinx of black quartz, judge my vow</td></tr>
      <tr><td>Regular Italic</td><td class="mono">400</td><td class="mono wt-demo" style="font-weight:400;font-style:italic">Sphinx of black quartz, judge my vow</td></tr>
      <tr><td>Medium</td><td class="mono">500</td><td class="mono wt-demo" style="font-weight:500">Sphinx of black quartz, judge my vow</td></tr>
      <tr><td>Medium Italic</td><td class="mono">500</td><td class="mono wt-demo" style="font-weight:500;font-style:italic">Sphinx of black quartz, judge my vow</td></tr>
      <tr><td>Bold</td><td class="mono">700</td><td class="mono wt-demo" style="font-weight:700">Sphinx of black quartz, judge my vow</td></tr>
      <tr><td>Bold Italic</td><td class="mono">700</td><td class="mono wt-demo" style="font-weight:700;font-style:italic">Sphinx of black quartz, judge my vow</td></tr>
    </tbody>
  </table>
</section>
