        <td><a class="dl-link" href="https://github.com/KorigamiK/Iosevka-Paper/releases/latest" target="_blank" rel="noopener">Download</a></td>
      </tr>
      <tr data-asset="^IosevkaPaper-WOFF2-\d">
        <td class="mono">WOFF2</td>
        <td>Web — <span class="mono">@font-face</span>, hinted</td>
        <td><span class="dl-num mono">—</span></td>
        <td><a class="dl-link" href="https://github.com/KorigamiK/Iosevka-Paper/releases/latest" target="_blank" rel="noopener">Download</a></td>
      </tr>
      <tr data-asset="^IosevkaPaper-WOFF2-Unhinted-">
