  <table class="dl-table">
    <thead><tr><th>Package</th><th>Best for</th><th class="dl-count-head">Downloads</th><th></th></tr></thead>
    <tbody>
      <tr data-asset="^IosevkaPaper-TTF-\d">
        <td class="mono">TTF</td>
        <td>Editors and terminals — hinted, standard-DPI displays</td>
        <td><span class="dl-num mono">—</span></td>
        <td><a class="dl-link" href="https://github.com/KorigamiK/Iosevka-Paper/releases/latest" target="_blank" rel="noopener">Download</a></td>
      </tr>
      <tr data-asset="^IosevkaPaper-TTF-Unhinted-">
